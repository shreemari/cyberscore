# ============================================================
# CyberScore — API environment variables
# ============================================================
# Copy this to .env (in apps/api/, NOT the repo root) for
# local development. In production we set the same keys in
# Vercel → Project → Settings → Environment Variables.
#
# Anything marked Sensitive should NEVER be committed. The
# `.env` files are in .gitignore at all levels; verify with:
#   git log --all --full-history --source -- '*/.env'
# It must return zero output.
# ============================================================

NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cyberscore?schema=public
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cyberscore?schema=public

# --- Redis (Upstash or local) ---
REDIS_URL=redis://localhost:6379

# --- JWT / refresh tokens ---
JWT_SECRET=replace_with_64_char_random_string
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace_with_64_char_random_string
REFRESH_TOKEN_EXPIRES_IN=7d

# --- AI chat advisor ---
# Default in production is the local rule-based advisor (free,
# no API key needed). Flip USE_LOCAL_ADVISOR to false to call
# Anthropic Claude instead — you must also set the API key
# and have budget on the Anthropic account.
USE_LOCAL_ADVISOR=true

# Only used when USE_LOCAL_ADVISOR=false:
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxx
# ANTHROPIC_MODEL_PRIMARY=claude-sonnet-4-6
# ANTHROPIC_MODEL_FALLBACK=claude-haiku-4-5
# ANTHROPIC_DAILY_BUDGET_USD=50

# --- Cloudflare R2 (or S3) ---
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=cyberscore-evidence
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://evidence.cyberscore.app

# --- Email delivery (OTP, invites, password reset) ---
# In production we use Brevo's HTTP API (auto-detected from
# the SMTP_PASS prefix `xkeysib-`). We don't use raw SMTP on
# Vercel because their serverless functions are unreliable
# for outbound TCP on 465/587 — emails sit in connection
# limbo until the function times out.
#
# For local dev: leave SMTP_PASS empty to fall back to
# nodemailer's JSON transport (no real send; logs the email
# content to console). For real emails locally, either:
#  - Sign up for Brevo and use your dev API key here
#  - Or use a tool like Mailtrap (set SMTP_HOST=smtp.mailtrap.io)
#
# Provider auto-detection in apps/api/src/lib/email.ts:
#   xkeysib-*   → Brevo HTTP API
#   re_*        → Resend HTTP API
#   anything    → nodemailer SMTP
SMTP_HOST=smtp.relay.brevo.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM="CyberScore <no-reply@cyberscore.app>"

# --- Expo push notifications ---
EXPO_ACCESS_TOKEN=

# --- Observability ---
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Rate limits (per IP / per window) ---
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=900000
