# ============================================================
# CyberScore — Mobile (Expo) environment variables
# ============================================================
# Copy this to .env in apps/mobile/ for local-dev overrides.
# In production, these are set on the EAS build profile (see
# eas.json) — they're baked into the JS bundle at build time
# because Expo requires the EXPO_PUBLIC_ prefix to inline them.
#
# Note: anything WITHOUT the EXPO_PUBLIC_ prefix is NOT
# accessible at runtime — only during the build step.

# --- API endpoint -------------------------------------------
#
# Where the mobile app sends API requests. Resolution order at
# runtime (see apps/mobile/src/lib/api.ts):
#   1. process.env.EXPO_PUBLIC_API_URL (this var)
#   2. Constants.expoConfig?.extra?.apiBaseUrl from app.json
#   3. fallback to http://localhost:3000
#
# For local dev on a physical device (not the iOS Simulator),
# localhost won't resolve — point at your Mac's LAN IP:
#   EXPO_PUBLIC_API_URL=http://192.168.1.20:3000
# Convenient one-liner that auto-detects your en0 IP:
#   EXPO_PUBLIC_API_URL=http://$(ipconfig getifaddr en0):3000
#
# For production builds via EAS, the value is set in eas.json
# under build.preview.env.EXPO_PUBLIC_API_URL — currently
# baked as the live Vercel URL.
EXPO_PUBLIC_API_URL=http://localhost:3000

# --- Sentry (optional) --------------------------------------
#
# Only set this if you want client-side crash reports flowing
# to your Sentry project. Leave unset to disable.
#
# EXPO_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
