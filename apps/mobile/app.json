{
  "expo": {
    "name": "CyMetric",
    "slug": "cymetric",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "cyberscore",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "backgroundColor": "#05060d",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cyberscore.app"
    },
    "android": {
      "package": "com.cyberscore.app",
      "adaptiveIcon": {
        "backgroundColor": "#05060d"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      "expo-notifications",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://cyberscore-main.vercel.app",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "099ac785-4853-4f81-8b50-642dd3940fe3"
      }
    },
    "owner": "fisst",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/099ac785-4853-4f81-8b50-642dd3940fe3"
    }
  }
}
