{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://cyberscore-main.vercel.app"
      },
      "channel": "preview"
    },
   
"production": {
  "android": {
    "buildType": "app-bundle"
  },
  "env": {
    "EXPO_PUBLIC_API_URL": "https://cyberscore-main.vercel.app"
  },
  "channel": "production"
}
  },
  "submit": {
    "production": {}
  }
}
