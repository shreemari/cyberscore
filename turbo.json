{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local", ".env"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "DATABASE_URL",
        "DIRECT_DATABASE_URL",
        "REDIS_URL",
        "JWT_SECRET",
        "REFRESH_TOKEN_SECRET",
        "TOTP_ENCRYPTION_KEY",
        "ANTHROPIC_API_KEY",
        "ANTHROPIC_MODEL_PRIMARY",
        "ANTHROPIC_MODEL_FALLBACK",
        "ANTHROPIC_DAILY_BUDGET_USD",
        "USE_LOCAL_ADVISOR",
        "R2_ACCESS_KEY_ID",
        "R2_SECRET_ACCESS_KEY",
        "R2_BUCKET",
        "R2_ENDPOINT",
        "R2_PUBLIC_URL",
        "SMTP_HOST",
        "SMTP_PORT",
        "SMTP_USER",
        "SMTP_PASS",
        "SMTP_FROM",
        "EXPO_ACCESS_TOKEN",
        "SENTRY_DSN",
        "RATE_LIMIT_LOGIN_MAX",
        "RATE_LIMIT_LOGIN_WINDOW_MS",
        "AI_FREE_DAILY_CALLS",
        "API_BASE_URL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "db:generate": {
      "cache": false,
      "outputs": ["node_modules/.prisma/**"]
    },
    "db:migrate": {
      "cache": false
    },
    "db:seed": {
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
